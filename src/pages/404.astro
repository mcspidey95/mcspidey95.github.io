---
import Base from '../layouts/Base.astro';
---
<Base title="404" description="Signal lost in the multiverse.">
  <section class="hero" style="min-height: 62vh; display: grid; align-items: center;">
    <div class="wrap">
      <div class="section-kicker" style="margin-bottom: 1rem;">Error 404 // Multiverse Drift</div>
      <h1 class="hero-title" data-split="lines" data-intro>Signal lost.</h1>
      <p class="hero-desc" data-reveal="up" data-intro data-delay="0.15">
        This route does not exist in this universe. Head back to base or hit Cmd+K.
      </p>
      <a class="btn" href="/" data-fill data-intro>
        <span class="btn__fill" aria-hidden="true"></span>
        <span>Return to Base</span>
      </a>
    </div>
  </section>
</Base>
