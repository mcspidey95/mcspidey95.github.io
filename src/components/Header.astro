---
import { site } from "../data/site";
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-dot" aria-hidden="true"></span>
      <span>{site.handle}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a class="draw" href="/#work" aria-current={path.startsWith("/work") ? "page" : undefined}>Work</a>
      <a class="draw" href="/#experience">Experience</a>
      <a class="draw" href="/#capabilities">Stack</a>
      <a class="draw" href={site.resume} target="_blank" rel="noreferrer">Resume</a>
    </nav>
    <div class="header-actions">
      <button type="button" class="pill-btn" data-alter-toggle aria-pressed="false" title="Toggle Spider-Sense mode (S)">
        <span>Spidey</span>
        <span class="kbd">S</span>
      </button>
      <button type="button" class="pill-btn" data-palette-open title="Command Palette">
        <span>Menu</span>
        <span class="kbd">Ctrl+K</span>
      </button>
    </div>
  </div>
</header>
