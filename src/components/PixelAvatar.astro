---
---
<div class="pixel-avatar-stage">
  <img class="pixel-img img-base" src="/assets/pfp-pixel.png" alt="Pixel-art portrait of Manish Bhat" data-critical />
  <img class="pixel-img img-alter" src="/assets/spidey-pixel.png" alt="Pixel-art Spider-Man alter-ego portrait" />
  <div class="pixel-scanlines" aria-hidden="true"></div>
  <svg class="pixel-hud img-base" viewBox="0 0 32 40" shape-rendering="crispEdges" aria-hidden="true">
    <g class="polaris-star">
      <rect x="27" y="3" width="1" height="3" fill="#22d3ee" />
      <rect x="26" y="4" width="3" height="1" fill="#22d3ee" />
    </g>
  </svg>
  <svg class="pixel-hud img-alter" viewBox="0 0 32 40" shape-rendering="crispEdges" aria-hidden="true">
    <g class="spidey-sense">
      <rect x="3" y="4" width="1" height="2" fill="#f43f5e" />
      <rect x="2" y="5" width="1" height="2" fill="#f43f5e" />
      <rect x="28" y="4" width="1" height="2" fill="#f43f5e" />
      <rect x="29" y="5" width="1" height="2" fill="#f43f5e" />
    </g>
  </svg>
</div>
